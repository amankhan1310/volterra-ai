# Copy to `.env` and adjust. Never commit `.env`.
# Placeholder development values only — no real secrets belong in this file.

# --- Backend (FastAPI) ---
VOLTERRA_ENV=development
VOLTERRA_API_HOST=127.0.0.1
VOLTERRA_API_PORT=8000
VOLTERRA_CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_USER=volterra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=volterra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://volterra:change-me@localhost:5432/volterra
# Test suite only: maintenance database used to create/drop disposable volterra_test_* databases.
TEST_DATABASE_URL=postgresql+asyncpg://volterra:change-me@localhost:5432/postgres
# The backend reads backend/.env; see backend/.env.example.

# --- Saved scenarios and request protection (defaults shown; see docs/deployment.md) ---
# shared (development default) | session (production default) | disabled (read-only)
# VOLTERRA_SCENARIO_ACCESS=shared
# HMAC key for anonymous session cookies, >= 32 characters; REQUIRED in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# VOLTERRA_SESSION_SECRET=
# VOLTERRA_SCENARIO_LIMIT=4
# VOLTERRA_SCENARIO_TOTAL_LIMIT=1000
# Rate limiting (on by default in production only; in-memory, per process)
# VOLTERRA_RATE_LIMIT=false
# VOLTERRA_RATE_LIMIT_READS=1200
# VOLTERRA_RATE_LIMIT_WRITES=30
# VOLTERRA_RATE_LIMIT_GLOBAL_WRITES=120
# VOLTERRA_TRUSTED_PROXY_HOPS=0
# VOLTERRA_MAX_BODY_BYTES=16384

# --- Storage (local filesystem; paths relative to repo root) ---
VOLTERRA_DATA_DIR=./data
VOLTERRA_ARTIFACTS_DIR=./artifacts

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
