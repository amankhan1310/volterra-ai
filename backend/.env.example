# Copy to backend/.env and replace the placeholders. backend/.env is git-ignored: never commit it.
# Percent-encode special characters in passwords (e.g. @ -> %40), since they sit inside a URL.

# Development database: migrations and seed run here (`uv run alembic upgrade head`).
DATABASE_URL=postgresql+asyncpg://volterra:change-me@localhost:5432/volterra

# Maintenance database used ONLY by the test suite to create and drop disposable databases
# named volterra_test_<random>. Tests never write to this database or to DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://volterra:change-me@localhost:5432/postgres

# Optional
# VOLTERRA_ENV=development
# VOLTERRA_CORS_ORIGINS=http://localhost:5173
# VOLTERRA_ANALYSIS_CACHE_SIZE=32
